# ============================================================
#  标准美式发音英语听读系统 - 环境配置示例
#  用法：复制本文件为 .env（同目录），按需填写，然后重启服务
#  说明：全部留空也能正常使用（浏览器 TTS + 离线评分引擎）
# ============================================================

# ---------- 基础 ----------
PORT=7000
HOST=0.0.0.0
# 数据存放目录（相对项目根目录或绝对路径）
DATA_DIR=data

# ---------- 管理控制台 /admin ----------
# 留空则仅允许本机访问（本地直跑）；Docker 部署时必须设置一个随机令牌，否则容器内
# 看不到 127.0.0.1，管理接口会全部 403。生成：node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
ADMIN_TOKEN=

# ---------- HTTPS（手机局域网录音必需） ----------
# 服务会自动检测 certs/cert.pem + certs/key.pem，存在即启用 HTTPS
# 没有证书则保持 HTTP。手机访问录音请用 https://<本机IP>:<端口>
# SSL_ENABLED=true
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem

# ---------- 语音合成 TTS ----------
# 可选：edge | browser | azure | tencent | openai
# edge    = 在线真人语音（微软神经网络，免费、无需 Key，男/女声自然音色，默认推荐）
# browser = 完全走浏览器内置语音（免费、零配置，但音色偏机械，断网兜底）
TTS_PROVIDER=edge

# Edge 真人语音默认音色（免费，无需 Key）
# 女声：en-US-AvaMultilingualNeural(推荐) / en-US-JennyNeural / en-US-AriaNeural / en-US-MichelleNeural
# 男声：en-US-AndrewMultilingualNeural(推荐) / en-US-GuyNeural / en-US-BrianMultilingualNeural / en-US-EricNeural
EDGE_TTS_VOICE=en-US-AvaMultilingualNeural

# Azure 语音服务（可选：如需 Azure 发音评估，可复用同一套 Key）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=en-US-AvaMultilingualNeural

# 腾讯云语音合成（国内网络友好）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# 英文音色：101051=WeRose(女) 101050=WeJack(男)
TENCENT_TTS_VOICE=101051

# OpenAI 兼容 TTS（可指向自建/中转网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---------- 发音评分 ----------
# 可选：offline | azure | tencent
# offline = 内置离线声学评分引擎（零配置，启发式估分）
ASSESS_PROVIDER=offline

# 腾讯云智聆口语评测 SOE（需在控制台创建应用拿到 SoeAppId）
TENCENT_SOE_APPID=

# 总分权重（准确度 / 流利度 / 完整度），三者之和建议为 1
SCORE_W_ACCURACY=0.5
SCORE_W_FLUENCY=0.3
SCORE_W_COMPLETENESS=0.2
